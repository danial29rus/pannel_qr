APP_NAME=Payments Control Panel
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://panel:panel@db:5432/panel
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:15173
ENFORCE_AUTH=true
ADMIN_TOKEN=replace-with-a-long-random-admin-token
OPERATOR_TOKEN=replace-with-a-long-random-operator-token
VIEWER_TOKEN=replace-with-a-long-random-viewer-token
RECONCILIATION_POLL_SECONDS=30
