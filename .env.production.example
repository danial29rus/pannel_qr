# Copy to .env.production on the server. Never commit the populated file.
POSTGRES_DB=panel
POSTGRES_USER=panel
POSTGRES_PASSWORD=generate-a-long-random-password
COMPOSE_PROJECT_NAME=clearpay-reserve
# Leave empty for a standby server; set to processing to start payment reconciliation.
COMPOSE_PROFILES=
# Choose caddy-shared when Vitrina's Caddy owns public ports 80/443.
DEPLOY_MODE=caddy-shared
# DNS A record for this host must point to the server running Vitrina/Caddy.
PANEL_DOMAIN=panel-trader.workkit-studio.ru
# Shared Docker network created by the Vitrina Compose project.
PROXY_NETWORK=vitrina_proxy
# Optional separate API hostname; empty means the same domain as the panel.
API_DOMAIN=
# Internal loopback ports for the system Nginx reverse proxy; never expose them in firewall.
API_BIND_PORT=18180
PANEL_BIND_PORT=15174
ADMIN_TOKEN=generate-a-long-random-admin-api-token
OPERATOR_TOKEN=generate-a-long-random-operator-api-token
VIEWER_TOKEN=generate-a-long-random-viewer-api-token
PANEL_ADMIN_USERNAME=admin
# scrypt$<base64-salt>$<base64-digest>; generate with the supplied command in README
PANEL_ADMIN_PASSWORD_HASH='scrypt$replace-with-base64-salt$replace-with-base64-digest'
PANEL_SESSION_SECRET=generate-a-long-random-session-secret
ACME_EMAIL=admin@example.com
BACKUP_DIR=/var/backups/clearpay-reserve
BACKUP_RETENTION_DAYS=30
