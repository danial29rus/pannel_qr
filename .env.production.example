# Copy to .env.production on the server. Never commit the populated file.
POSTGRES_DB=panel
POSTGRES_USER=panel
POSTGRES_PASSWORD=generate-a-long-random-password
PANEL_DOMAIN=panel.workkit-studio.ru
API_DOMAIN=api.workkit-studio.ru
ADMIN_TOKEN=generate-a-long-random-admin-api-token
OPERATOR_TOKEN=generate-a-long-random-operator-api-token
VIEWER_TOKEN=generate-a-long-random-viewer-api-token
PANEL_ADMIN_USERNAME=admin
# scrypt$<base64-salt>$<base64-digest>; generate with the supplied command in README
PANEL_ADMIN_PASSWORD_HASH='scrypt$replace-with-base64-salt$replace-with-base64-digest'
PANEL_SESSION_SECRET=generate-a-long-random-session-secret
ACME_EMAIL=admin@workkit-studio.ru
BACKUP_DIR=/var/backups/clearpay
BACKUP_RETENTION_DAYS=30
